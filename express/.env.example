# Somnium API environment.
# Copy to .env and fill in. The server validates this file at boot
# (src/config/env.ts) and exits listing anything missing or malformed.

# --- Server ---------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Docker Database Config (Used by docker-compose.yml) ------------------
POSTGRES_USER=somnium
POSTGRES_PASSWORD=change_this_to_a_secure_password
POSTGRES_DB=somnium

# --- Database (required) --------------------------------------------------
# Connects to the local Docker Postgres container.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# --- Google OAuth (required) ----------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must be registered verbatim as an Authorized redirect URI in Google Cloud.
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Frontend (required) --------------------------------------------------
# Comma-separated. The FIRST entry is canonical: it is the post-sign-in
# redirect target. Every entry is allowed through CORS and the Socket.IO
# handshake. No trailing slashes.
FRONTEND_URL=http://localhost:5173

# --- Auth (required) -----------------------------------------------------
# Minimum 32 characters — a short HS256 secret is brute-forceable offline.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-at-least-32-random-characters

# Comma-separated emails promoted to ADMIN on sign-in. Leave empty and no
# account can reach /admin/* — every user defaults to PLAYER.
ADMIN_EMAILS=

# --- Optional ------------------------------------------------------------
# Connects to the local Docker Redis container.
REDIS_URL=redis://redis:6379

# Set only when the API and the site share a parent domain.
# COOKIE_DOMAIN=.yourdomain.com

# Overrides the SameSite default (none in production, lax in development).
# COOKIE_SAMESITE=lax
