# Server Config
PORT=3000
NODE_ENV=development

# PostgreSQL / Neon Database Configuration
# Required. This is the only DB variable the connection pool reads
# (shared/db/pg.ts builds the Pool from it). Paste the Neon connection string:
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
#
# The DB_* vars below are optional and currently unused — nothing reads them.
# DB_USER=postgres
# DB_HOST=127.0.0.1
# DB_NAME=ctf_db
# DB_PASSWORD=your_postgres_password
# DB_PORT=5432

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must be registered verbatim as an Authorized redirect URI in Google Cloud.
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Origin of the Vite app. Used for the CORS allow-list and as the redirect
# target after the OAuth callback — no trailing slash.
FRONTEND_URL=http://localhost:5173

# JWT Configuration
JWT_SECRET=your-jwt-secret-change-me
# COOKIE_DOMAIN=.yourdomain.com  # Optional — omit for localhost dev
