# Frontend environment. Copy this file to .env before running the app.
# Vite only exposes variables prefixed with VITE_ to the browser.

# Base URL of the Express API (no trailing slash).
# Every request in src/api/ resolves against this, and it is also the origin
# the Google sign-in button navigates to (GET /auth/google).
VITE_API_URL=http://localhost:3000

# Note: no Google client ID or secret belongs here. The OAuth round trip is
# handled entirely by the backend, which holds the credentials and sets an
# httpOnly session cookie. See express/.env.example for those values.
